{
  "name": "@spire/kernel",
  "version": "0.1.0",
  "description": "Spire modular application kernel",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./api/src/public/index.js",
    "./db": "./api/src/public/db.js",
    "./hooks": "./api/src/public/hooks.js",
    "./events": "./api/src/public/events.js",
    "./http": "./api/src/public/http.js",
    "./logging": "./api/src/public/logging.js",
    "./context": "./api/src/public/context.js"
  },
  "scripts": {
    "dev:api": "node --watch api/src/server.js",
    "dev:web": "npm run modules:generate && vite --config web/vite.config.js",
    "start": "node api/src/server.js",
    "build:web": "npm run modules:generate && vite build --config web/vite.config.js",
    "modules:generate": "node scripts/generate-module-registry.js",
    "events:worker": "node api/src/events/worker.js",
    "db:init": "node api/scripts/db-init.js",
    "db:contract:generate": "node api/scripts/db-contract-generate.js",
    "db:contract:check": "node api/scripts/db-contract-check.js",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "fastify": "^5.2.1",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "zod": "^3.24.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}

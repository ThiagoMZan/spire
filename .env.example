# Ambiente de execução. Alterações neste arquivo exigem reiniciar os processos.
NODE_ENV=development
# Porta HTTP da API.
PORT=3000
# Nível dos logs estruturados (debug, info, warn, error).
LOG_LEVEL=info

# Conexão PostgreSQL compartilhada pela API e pelos workers.
DATABASE_URL=postgres://spire:spire@localhost:5432/spire
# Origem permitida para chamadas do frontend à API.
CORS_ORIGIN=http://localhost:5173

# Prefixo usado para descobrir pacotes de módulos instalados.
SPIRE_MODULE_PREFIX=@spire/module-
# Pacotes adicionais de módulos, separados por vírgula; vazio usa a descoberta padrão.
SPIRE_MODULE_PACKAGES=

# Schemas incluídos na introspecção do contrato de banco, separados por vírgula.
DB_CONTRACT_SCHEMAS=kernel

# Máximo de sessões simultâneas por usuário; novo login revoga as mais antigas.
AUTH_MAX_SESSIONS_PER_USER=1
# Expiração por inatividade, em segundos (1800 = 30 minutos).
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
# Duração máxima da sessão, em segundos (86400 = 24 horas), mesmo com atividade.
AUTH_SESSION_MAX_AGE_SECONDS=86400

# Intervalo entre consultas do worker por eventos pendentes, em milissegundos.
EVENT_WORKER_POLL_MS=1000
# Quantidade máxima de entregas reclamadas por lote do worker.
EVENT_WORKER_BATCH_SIZE=20
# Número máximo de tentativas de processamento por entrega.
EVENT_WORKER_MAX_ATTEMPTS=10
# Prazo para recuperar uma entrega com bloqueio abandonado, em milissegundos.
EVENT_WORKER_LOCK_TIMEOUT_MS=300000

# Driver de arquivos; local é destinado ao desenvolvimento. S3 ainda não está implementado.
FILES_STORAGE_DRIVER=local
# Diretório de arquivos locais, relativo ao diretório de execução.
FILES_LOCAL_DIR=./storage/files

# Arte decorativa do login por cliente. Caminho público; reinicie o dev ou refaça o build após alterar.
VITE_LOGIN_ART_URL=/images/login-art.svg
